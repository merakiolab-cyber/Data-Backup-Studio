{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data Backup Studio",
  "mainBinaryName": "data-backup-studio",
  "version": "0.1.0",
  "identifier": "app.databackupstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1427",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Data Backup Studio",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Offline zálohování složek na externí disky",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "languages": ["Czech"],
        "installMode": "currentUser"
      }
    }
  }
}
